# ============================================================
# ChitralSafe Backend — Environment Variables Template
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Edit .env with your values
#   3. NEVER commit .env to GitHub (it's in .gitignore)
# ============================================================

# ── Environment ───────────────────────────────────────────────
# Options: development | production
ENV=development

# ── Database ──────────────────────────────────────────────────
# Default: SQLite in system TEMP folder (auto-created)
# For PostgreSQL: postgresql+asyncpg://user:pass@localhost/dbname
DATABASE_URL=sqlite+aiosqlite:///./disaster_dss.sqlite

# ── Security (CHANGE THESE IN PRODUCTION) ─────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-32-char-secret-key
ADMIN_API_KEY=change-me-to-a-strong-admin-key

# ── JWT Token TTLs ────────────────────────────────────────────
ACCESS_TOKEN_TTL=3600       # 1 hour (in seconds)
REFRESH_TOKEN_TTL=604800    # 7 days (in seconds)

# ── AI / LLM Provider ─────────────────────────────────────────
# Options: none | ollama | openai | groq
#
# Option A: No LLM (offline retrieval only — no setup needed)
LLM_PROVIDER=none
#
# Option B: Ollama (FREE, runs locally — recommended)
# Install: https://ollama.com  then run: ollama pull llama3
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
#
# Option C: OpenAI
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-openai-api-key-here
#
# Option D: Groq (fast free tier)
# LLM_PROVIDER=groq
# LLM_MODEL=llama3-8b-8192
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your-groq-api-key-here

LLM_MODEL=llama3
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MAX_TOKENS=400
LLM_MIN_CONFIDENCE=1

# ── Real-Time Alert Scraping ──────────────────────────────────
# Set MONITOR_ENABLED=0 to disable background scraping
MONITOR_ENABLED=1
MONITOR_INTERVAL_HOURS=6
BACKEND_URL=http://127.0.0.1:8002

# ── CORS ──────────────────────────────────────────────────────
# Add your Flutter web app URL here
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_LOGIN=10/minute

# ── Debug ─────────────────────────────────────────────────────
# Set SQL_ECHO=1 to log all SQL queries (useful for debugging)
SQL_ECHO=0
